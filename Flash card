<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FSRS 智慧英語單字閃卡</title>
    <style>
        :root {
            --primary: #4F46E5;
            --primary-hover: #4338CA;
            --bg: #F3F4F6;
            --card-bg: #FFFFFF;
            --text: #1F2937;
            --success: #10B981;
            --danger: #EF4444;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 600px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        header {
            text-align: center;
        }

        h1 {
            margin: 0 0 10px 0;
            color: var(--primary);
            font-size: 1.8rem;
        }

        .panel {
            background: var(--card-bg);
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .controls {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 15px;
        }

        label {
            font-size: 0.85rem;
            font-weight: bold;
            margin-bottom: 4px;
            display: block;
        }

        select, input[type="file"], button, textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #D1D5DB;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 0.9rem;
        }

        button {
            background-color: var(--primary);
            color: white;
            border: none;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        button:hover {
            background-color: var(--primary-hover);
        }

        button.btn-danger {
            background-color: var(--danger);
        }

        /* 閃卡區域 */
        .card-container {
            position: relative;
            width: 100%;
            height: 320px;
            perspective: 1000px;
        }

        .card {
            width: 100%;
            height: 100%;
            position: absolute;
            transform-style: preserve-3d;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 16px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            cursor: pointer;
            touch-action: none;
        }

        .card.flipped {
            transform: rotateY(180deg);
        }

        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            background: var(--card-bg);
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
            box-sizing: border-box;
            user-select: none;
            border: 2px solid #E5E7EB;
        }

        .card-back {
            transform: rotateY(180deg);
        }

        .card-text {
            font-size: 2rem;
            font-weight: bold;
            text-align: center;
            word-break: break-word;
        }

        /* 可點擊發音區域 */
        .tts-zone {
            position: absolute;
            top: 20px;
            left: 20px;
            right: 20px;
            bottom: 60px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 8px;
            cursor: pointer;
        }

        .tts-zone:hover {
            background-color: rgba(79, 70, 229, 0.05);
        }

        .tts-icon {
            position: absolute;
            top: 15px;
            right: 15px;
            font-size: 1.2rem;
            opacity: 0.5;
        }

        .sub-text {
            font-size: 0.9rem;
            color: #6B7280;
            margin-top: 10px;
        }

        /* 翻轉與操作提示按鈕 */
        .action-btns {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            background: #E5E7EB;
            margin-top: 10px;
        }

        .swipe-hint {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            color: #6B7280;
            margin-top: 5px;
        }

        /* 單字清單預覽與管理 */
        .deck-list {
            max-height: 150px;
            overflow-y: auto;
            margin-top: 10px;
            border: 1px solid #E5E7EB;
            border-radius: 6px;
        }

        .deck-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 12px;
            border-bottom: 1px solid #E5E7EB;
        }

        .deck-item:last-child {
            border-bottom: none;
        }

        .empty-state {
            text-align: center;
            padding: 4px;
            color: #9CA3AF;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>FSRS 智慧單字卡</h1>
    </header>

    <!-- 設定面板 -->
    <div class="panel">
        <div class="controls">
            <div>
                <label for="directionSelect">翻卡方向</label>
                <select id="directionSelect">
                    <option value="en2zh">英文 ➔ 中文</option>
                    <option value="zh2en">中文 ➔ 英文</option>
                </select>
            </div>
            <div>
                <label for="voiceSelect">TTS 語音發音</label>
                <select id="voiceSelect">
                    <option value="">載入中...</option>
                </select>
            </div>
        </div>

        <div>
            <label>匯入單字表 (格式: 英文,中文 每行一個)</label>
            <input type="file" id="fileInput" accept=".txt,.csv" />
        </div>
    </div>

    <!-- 閃卡主區域 -->
    <div id="flashcardArea" style="display:none;">
        <div class="card-container">
            <div class="card" id="card">
                <!-- 正面 -->
                <div class="card-face card-front">
                    <span class="tts-icon">🔊 點擊發音</span>
                    <div class="tts-zone" onclick="speakCurrent(event)"></div>
                    <div class="card-text" id="frontText"></div>
                    <div class="sub-text">正面</div>
                </div>
                <!-- 背面 -->
                <div class="card-face card-back">
                    <span class="tts-icon">🔊 點擊發音</span>
                    <div class="tts-zone" onclick="speakCurrent(event)"></div>
                    <div class="card-text" id="backText"></div>
                    <div class="badge" id="fsrsStats">--</div>
                </div>
            </div>
        </div>

        <div class="swipe-hint">
            <span>👈 左滑：忘記 (Again)</span>
            <span>👉 右滑：記得 (Good)</span>
        </div>

        <div class="action-btns">
            <button onclick="handleResponse('again')" style="background-color: var(--danger)">忘記 (左滑)</button>
            <button onclick="flipCard()">翻轉卡片</button>
            <button onclick="handleResponse('good')" style="background-color: var(--success)">記得 (右滑)</button>
        </div>
    </div>

    <!-- 單字庫管理面板 -->
    <div class="panel">
        <h3>目前單字庫 (<span id="cardCount">0</span>)</h3>
        <div class="deck-list" id="deckList">
            <div class="empty-state">目前沒有單字，請上傳檔案。</div>
        </div>
        <button class="btn-danger" style="margin-top: 10px;" onclick="clearDeck()">刪除全部單字庫</button>
    </div>
</div>

<script>
    // ==========================================
    // 1. FSRS-6 簡化演算法核心 logic
    // ==========================================
    // 基於 Anki FSRS 演算法的精神實作的核心公式
    class FSRS {
        constructor() {
            this.w = [0.4, 0.6, 2.4, 5.8, 4.93, 0.94, 0.86, 0.01, 1.49, 0.14, 0.94, 2.18, 0.05, 0.34, 1.26, 0.29, 2.61];
        }

        // 初始化新卡片
        initCard() {
            return {
                stability: 0,
                difficulty: 0,
                elapsed_days: 0,
                scheduled_days: 0,
                repetition: 0,
                state: 'New', // New, Learning, Review
                last_review: null
            };
        }

        // 核心更新公式: rating (1:忘記/Again, 3:記得/Good)
        next(card, rating) {
            let s = card.stability;
            let d = card.difficulty;
            const now = new Date().toISOString();

            if (card.state === 'New') {
                d = Math.max(1, Math.min(10, 8.25 - (rating - 3) * 1.5));
                s = rating === 1 ? this.w[0] : this.w[2];
                return {
                    ...card,
                    stability: s,
                    difficulty: d,
                    repetition: 1,
                    state: 'Learning',
                    last_review: now,
                    scheduled_days: Math.round(s)
                };
            }

            // 更新難度 D
            const next_d = Math.max(1, Math.min(10, d - 0.8 * (rating - 3)));
            
            // 更新穩定度 S
            let next_s = s;
            if (rating === 1) { // 忘記 (Again)
                next_s = Math.max(0.1, this.w[11] * Math.pow(next_d, -this.w[12]) * (Math.pow(s + 1, this.w[13]) - 1));
            } else { // 記得 (Good)
                next_s = s * (1 + Math.exp(this.w[8]) * (11 - next_d) * Math.pow(s, -this.w[9]));
            }

            return {
                ...card,
                stability: parseFloat(next_s.toFixed(2)),
                difficulty: parseFloat(next_d.toFixed(2)),
                repetition: card.repetition + 1,
                state: 'Review',
                last_review: now,
                scheduled_days: Math.max(1, Math.round(next_s))
            };
        }
    }

    const fsrs = new FSRS();

    // ==========================================
    // 2. 資料管理 (LocalStorage)
    // ==========================================
    let deck = JSON.parse(localStorage.getItem('fsrs_deck')) || [];
    let currentIndex = 0;
    let isFlipped = false;

    function saveDeck() {
        localStorage.setItem('fsrs_deck', JSON.stringify(deck));
        renderDeckList();
    }

    // ==========================================
    // 3. TTS 語音功能
    // ==========================================
    const synth = window.speechSynthesis;
    const voiceSelect = document.getElementById('voiceSelect');
    let voices = [];

    function populateVoiceList() {
        voices = synth.getVoices().filter(v => v.lang.includes('en'));
        voiceSelect.innerHTML = '';
        
        const usVoices = voices.filter(v => v.lang.includes('US') || v.lang.includes('en-US'));
        const ukVoices = voices.filter(v => v.lang.includes('GB') || v.lang.includes('en-GB'));
        const otherVoices = voices.filter(v => !usVoices.includes(v) && !ukVoices.includes(v));

        const addGroup = (label, list) => {
            if (list.length === 0) return;
            const group = document.createElement('optgroup');
            group.label = label;
            list.forEach(voice => {
                const option = document.createElement('option');
                option.textContent = `${voice.name} (${voice.lang})`;
                option.value = voice.name;
                group.appendChild(option);
            });
            voiceSelect.appendChild(group);
        };

        addGroup('美式英語 (US)', usVoices);
        addGroup('英式英語 (UK)', ukVoices);
        addGroup('其他英語', otherVoices);
    }

    populateVoiceList();
    if (speechSynthesis.onvoiceschanged !== undefined) {
        speechSynthesis.onvoiceschanged = populateVoiceList;
    }

    function speakText(text) {
        if (!text || synth.speaking) synth.cancel(); // 停止先前的發音
        const utterThis = new SpeechSynthesisUtterance(text);
        const selectedOption = voiceSelect.value;
        const selectedVoice = voices.find(v => v.name === selectedOption);
        if (selectedVoice) {
            utterThis.voice = selectedVoice;
        }
        synth.speak(utterThis);
    }

    function speakCurrent(event) {
        if(event) event.stopPropagation(); // 阻止觸發卡片翻轉
        const currentCard = deck[currentIndex];
        if (!currentCard) return;

        const direction = document.getElementById('directionSelect').value;
        let textToRead = "";

        if (!isFlipped) {
            textToRead = direction === 'en2zh' ? currentCard.en : currentCard.zh;
        } else {
            textToRead = direction === 'en2zh' ? currentCard.zh : currentCard.en;
        }

        // 僅朗讀包含英文字元的部分
        if (/[a-zA-Z]/.test(textToRead)) {
            speakText(textToRead);
        }
    }

    // ==========================================
    // 4. 卡片互動 logic
    // ==========================================
    const cardElem = document.getElementById('card');
    const frontTextElem = document.getElementById('frontText');
    const backTextElem = document.getElementById('backText');
    const fsrsStatsElem = document.getElementById('fsrsStats');

    function renderCard() {
        if (deck.length === 0) {
            document.getElementById('flashcardArea').style.display = 'none';
            return;
        }
        document.getElementById('flashcardArea').style.display = 'block';

        const item = deck[currentIndex];
        const direction = document.getElementById('directionSelect').value;

        if (direction === 'en2zh') {
            frontTextElem.innerText = item.en;
            backTextElem.innerText = item.zh;
        } else {
            frontTextElem.innerText = item.zh;
            backTextElem.innerText = item.en;
        }

        fsrsStatsElem.innerText = `穩定度: ${item.fsrs.stability} | 難度: ${item.fsrs.difficulty} | 下次複習: ${item.fsrs.scheduled_days}天後`;
        
        // 重設卡片翻轉狀態
        isFlipped = false;
        cardElem.classList.remove('flipped');
    }

    function flipCard() {
        isFlipped = !isFlipped;
        cardElem.classList.toggle('flipped');
    }

    document.getElementById('directionSelect').addEventListener('change', renderCard);

    // 評分與 FSRS 演算邏輯 (Again=1, Good=3)
    function handleResponse(type) {
        if (deck.length === 0) return;

        const rating = type === 'again' ? 1 : 3;
        const card = deck[currentIndex];
        
        // 經由 FSRS 更新狀態
        card.fsrs = fsrs.next(card.fsrs, rating);
        saveDeck();

        // 切換至下一張卡片
        currentIndex = (currentIndex + 1) % deck.length;
        renderCard();
    }

    // ==========================================
    // 5. 滑動卡片機制 (Swipe Interaction)
    // ==========================================
    let startX = 0;
    let currentX = 0;
    let isDragging = false;

    cardElem.addEventListener('pointerdown', (e) => {
        // 如果點擊的是 TTS zone 就不觸發滑動
        if(e.target.classList.contains('tts-zone')) return;
        
        isDragging = true;
        startX = e.clientX;
        cardElem.style.transition = 'none';
    });

    document.addEventListener('pointermove', (e) => {
        if (!isDragging) return;
        currentX = e.clientX - startX;
        const rotate = currentX * 0.05;
        cardElem.style.transform = `translateX(${currentX}px) rotate(${rotate}deg) ${isFlipped ? 'rotateY(180deg)' : ''}`;
    });

    document.addEventListener('pointerup', () => {
        if (!isDragging) return;
        isDragging = false;
        cardElem.style.transition = 'transform 0.5s ease';

        if (currentX > 100) { // 右滑 -> 記得
            handleResponse('good');
        } else if (currentX < -100) { // 左滑 -> 忘記
            handleResponse('again');
        } else {
            // 回到原位
            cardElem.style.transform = isFlipped ? 'rotateY(180deg)' : 'none';
        }
        currentX = 0;
    });

    // 點擊卡片翻轉 (若未發生顯著滑動)
    cardElem.addEventListener('click', (e) => {
        if (Math.abs(currentX) < 5 && !e.target.classList.contains('tts-zone')) {
            flipCard();
        }
    });

    // ==========================================
    // 6. 檔案上傳與單字庫管理
    // ==========================================
    document.getElementById('fileInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            const content = e.target.result;
            const lines = content.split('\n');
            let newCards = 0;

            lines.forEach(line => {
                // 支援 逗號, 頓號, 或 Tab 分割格式
                const parts = line.split(/[,，\t]/);
                if (parts.length >= 2) {
                    const en = parts[0].trim();
                    const zh = parts[1].trim();
                    if (en && zh) {
                        deck.push({
                            id: Date.now() + Math.random(),
                            en: en,
                            zh: zh,
                            fsrs: fsrs.initCard()
                        });
                        newCards++;
                    }
                }
            });

            if (newCards > 0) {
                saveDeck();
                currentIndex = deck.length - newCards;
                renderCard();
                alert(`成功匯入 ${newCards} 個單字！`);
            } else {
                alert('解析失敗，請確認檔案格式為每行「英文,中文」');
            }
        };
        reader.readAsText(file);
    });

    function renderDeckList() {
        const deckListElem = document.getElementById('deckList');
        document.getElementById('cardCount').innerText = deck.length;

        if (deck.length === 0) {
            deckListElem.innerHTML = '<div class="empty-state">目前沒有單字，請上傳檔案。</div>';
            return;
        }

        deckListElem.innerHTML = '';
        deck.forEach((item, idx) => {
            const div = document.createElement('div');
            div.className = 'deck-item';
            div.innerHTML = `
                <span><strong>${item.en}</strong> - ${item.zh}</span>
                <button class="btn-danger" style="width:auto; padding: 4px 8px;" onclick="deleteCard(${idx})">刪除</button>
            `;
            deckListElem.appendChild(div);
        });
    }

    function deleteCard(index) {
        deck.splice(index, 1);
        if (currentIndex >= deck.length) currentIndex = Math.max(0, deck.length - 1);
        saveDeck();
        renderCard();
    }

    function clearDeck() {
        if (confirm('確定要清空所有單字庫嗎？此操作無法復原。')) {
            deck = [];
            currentIndex = 0;
            saveDeck();
            renderCard();
        }
    }

    // 初始化載入
    renderDeckList();
    renderCard();

</script>
</body>
</html>
